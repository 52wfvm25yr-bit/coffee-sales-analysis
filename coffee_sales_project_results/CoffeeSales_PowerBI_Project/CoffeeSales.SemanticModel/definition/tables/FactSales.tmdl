table FactSales

	measure 'Record Count' = COUNTROWS(FactSales)
		formatString: #,##0

	measure 'Total Money' = SUM(FactSales[money])
		formatString: #,##0.00

	measure 'Average Money' = AVERAGE(FactSales[money])
		formatString: #,##0.00

	measure 'Median Money' = MEDIAN(FactSales[money])
		formatString: #,##0.00

	measure 'Drink Count' = DISTINCTCOUNT(FactSales[coffee_name])
		formatString: #,##0

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column hour_of_day
		dataType: int64
		summarizeBy: none
		sourceColumn: hour_of_day

	column money
		dataType: double
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: money

	column coffee_name
		dataType: string
		summarizeBy: none
		sourceColumn: coffee_name

	column Time_of_Day
		dataType: string
		summarizeBy: none
		sourceColumn: Time_of_Day

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: Weekdaysort

	column Weekdaysort
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Weekdaysort

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column cash_type
		dataType: string
		summarizeBy: none
		sourceColumn: cash_type

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	partition FactSales = m
		mode: import
		source =
			let
